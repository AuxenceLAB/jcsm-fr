# HTTP → HTTPS + www → non-www redirect
server {
    listen 80;
    server_name jcsm.fr www.jcsm.fr;
    return 301 https://jcsm.fr$request_uri;
}

# www → non-www HTTPS redirect
server {
    listen 443 ssl;
    http2 on;
    server_name www.jcsm.fr;

    ssl_certificate     /etc/ssl/certs/jcsm.fr.crt;
    ssl_certificate_key /etc/ssl/private/jcsm.fr.key;
    include     /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://jcsm.fr$request_uri;
}

# Redirections legacy en UN SEUL saut (avant : /interventions.html → 301
# /interventions → 301 /exploitation, soit 2 sauts, car le `if` generique .html
# ci-dessous court-circuitait les `location =` dediees).
# Teste sur $request_uri (URI externe brute uniquement) comme les regles .html,
# donc les redirections internes (error_page 404, index) ne sont pas interceptees.
# Couvre /xxx, /xxx/, /xxx.html, avec ou sans query string (query supprimee,
# comme avant).
map $request_uri $jcsm_legacy_redirect {
    default "";
    "~^/(?:interventions|services)(?:\.html)?/?(?:\?.*)?$"      /exploitation;
    "~^/support-client(?:\.html)?/?(?:\?.*)?$"                  /centre-appel;
    "~^/securisation(?:\.html)?/?(?:\?.*)?$"                    /securisation-installations;
    "~^/(?:mise-en-service|expertise)(?:\.html)?/?(?:\?.*)?$"   /installation-conformite;
    "~^/de/installation-security(?:\.html)?/?(?:\?.*)?$"        /de/anlagensicherung;
    "~^/de/operations-maintenance(?:\.html)?/?(?:\?.*)?$"       /de/betrieb-wartung;
    "~^/de/call-center(?:\.html)?/?(?:\?.*)?$"                  /de/callcenter;
}

# Main HTTPS server
server {
    server_name jcsm.fr;

    root /var/www/jcsm.fr;
    index index.html index.php;

    # Custom 404 page
    error_page 404 /404.html;

    # HTTP/2
    http2 on;

    # En-tetes de securite par defaut au niveau server : couvre les reponses qui
    # n'en avaient AUCUN (404 via /404.html interne, redirections 301 ci-dessous,
    # 403 des locations deny). Les locations qui declarent leur propre add_header
    # incluent deja ce snippet et gardent leur jeu complet (heritage non cumulatif).
    include /etc/nginx/snippets/security.conf;

    # Legacy 301 en un seul saut (voir map $jcsm_legacy_redirect en tete de fichier).
    # DOIT rester avant les regles .html generiques.
    if ($jcsm_legacy_redirect) {
        return 301 $jcsm_legacy_redirect;
    }

    # Redirect .html URLs to pretty URLs (SEO canonical) — tested on $request_uri
    # (the EXTERNAL request only) so that internal rewrites (error_page 404,
    # index module /xx/ → /xx/index.html) are NOT intercepted (fix soft-404
    # sitewide + 301 parasites sur /en/ /de/ ... contredisant les canonicals).
    if ($request_uri ~ "^/((?:[^?]+/)?)index\.html(\?|$)") {
        return 301 /$1;
    }
    if ($request_uri ~ "^/([^?]+)\.html(\?|$)") {
        return 301 /$1;
    }

    # (Les anciennes `location =` de redirection legacy — /interventions,
    # /support-client, /securisation, /mise-en-service, /services, /expertise,
    # /de/* — sont remplacees par le map ci-dessus : un seul saut pour les
    # formes .html ET sans extension.)
    location = /index.html { return 301 /; }

    # 404 page: only reachable via error_page internal redirect (never 301'd,
    # never served 200 directly)
    location = /404.html {
        internal;
    }

    # Root: serve index.html directly (avoids index directive → /index.html redirect loop)
    location = / {
        limit_req zone=req_limit_per_ip burst=20 nodelay;
        limit_conn conn_limit_per_ip 20;
        include /etc/nginx/snippets/security.conf;
        add_header Cache-Control "public, max-age=3600" always;
        try_files /index.html =404;
    }

    # Pretty URLs: try without .html extension
    # Also serves as HTML cache policy (1 hour)
    location / {
        limit_req zone=req_limit_per_ip burst=20 nodelay;
        limit_conn conn_limit_per_ip 20;
        include /etc/nginx/snippets/security.conf;
        add_header Cache-Control "public, max-age=3600" always;
        try_files $uri $uri.html $uri/ =404;
    }

    # Modules internes inclus par require_once : jamais servis directement.
    location ~ ^/api/(auth|helpers|indexnow)\.php$ {
        deny all;
    }

    # Webhooks Twilio publics. La signature est validee dans le PHP.
    location ~ ^/api/twilio-(incoming-sms|voice-twiml)\.php$ {
        limit_req zone=req_limit_per_ip burst=20 nodelay;
        limit_conn conn_limit_per_ip 20;
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include /etc/nginx/snippets/security.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    # PHP-FPM : uniquement les scripts situes directement dans /api/.
    location ~ ^/api/[^/]+\.php$ {
        limit_req zone=req_limit_per_ip burst=20 nodelay;
        limit_conn conn_limit_per_ip 20;
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;

        include /etc/nginx/snippets/security.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
    }

    # Refuse tout autre PHP, notamment les dependances et les uploads.
    location ~ \.php$ {
        deny all;
    }

    # Block access to sensitive files
    location ~ /\.(?!well-known) {
        deny all;
    }
    location ~ \.(env|sql|sh|log|lock|tmp|gpg|jsonl|py)$ {
        deny all;
    }
    # Block .md files, package.json, and scripts directory
    location ~ \.(md)$ {
        deny all;
    }
    location = /package.json {
        deny all;
    }
    location = /package-lock.json {
        deny all;
    }
    location ^~ /config/ {
        deny all;
    }
    location ^~ /scripts/ {
        deny all;
    }
    location ^~ /docs/ {
        deny all;
    }
    location ^~ /api/vendor/ {
        deny all;
    }
    # Block node_modules directory
    location ^~ /node_modules/ {
        deny all;
    }
    # Block the entire /demo/ mirror (stale full-site copy, PII + duplicate content)
    location ^~ /demo/ {
        deny all;
    }
    # Block work-in-progress design previews
    # TOUT FICHIER PREFIXE D'UN SOULIGNE EST INTERNE, pas seulement celui-la.
    # Mesure du 2026-08-30 : `_design-preview` etait bloque ici ET dans
    # robots.txt, mais `_design-2026`, ajoute plus tard, repondait 200 au public
    # (« proposition de direction visuelle 2026 »). Nommer les fichiers un par un
    # garantit qu'on oubliera le suivant.
    location ~ ^/_[^/]*(\.html)?$ {
        deny all;
    }
    # Block internal/demo pages (any depth: also /demo/interne, /demo/demo/interne, ...)
    location ~ (^|/)(interne|internedemo|ca|ca1|ca2)(\.html)?$ {
        deny all;
    }
    # Block backup/editor leftovers anywhere (.bak, .bak-YYYYMMDD, .old, .orig, .save, .swp)
    location ~* \.(bak|old|orig|save|swp)(-|\.|$) {
        deny all;
    }

    # Block direct access to API data files (JSON)
    location ~ ^/api/.*\.json$ {
        deny all;
    }
    # Block direct access to API data storage
    location ^~ /api/data/ {
        deny all;
    }

    # Service Worker - never cache immutably (must check for updates)
    location = /sw.js {
        include /etc/nginx/snippets/security.conf;
        add_header Cache-Control "no-cache, must-revalidate" always;
        try_files $uri =404;
    }

    # Rapports - allow access to generated reports
    location ^~ /rapports/ {
        limit_req zone=req_limit_per_ip burst=20 nodelay;
        limit_conn conn_limit_per_ip 20;
        autoindex off;
        include /etc/nginx/snippets/security.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files $uri =404;
    }

    # Cache images (1 month) - no rate limiting for static assets
    location ~* \.(png|jpg|jpeg|gif|svg|webp|ico)$ {
        include /etc/nginx/snippets/security.conf;
        add_header Cache-Control "public, max-age=2592000, immutable" always;
        try_files $uri =404;
    }

    # Cache fonts (1 year)
    location ~* \.(woff2?|ttf|otf|eot)$ {
        include /etc/nginx/snippets/security.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Cache CSS/JS (1 week)
    location ~* \.(css|js)$ {
        include /etc/nginx/snippets/security.conf;
        add_header Cache-Control "public, max-age=604800, immutable" always;
        try_files $uri =404;
    }

    # Configuration SSL (Gérée par Certbot)
    listen 443 ssl;
    ssl_certificate     /etc/ssl/certs/jcsm.fr.crt;
    ssl_certificate_key /etc/ssl/private/jcsm.fr.key;
    include     /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}
